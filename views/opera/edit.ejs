<% title=locals.title %>

  <form method="post" action="/opera/<%= opus.authorId %>/<%= opus.opusId %>/edit">
    <div class="row p-5">
      <div class="col-2">
        <label for="id" class="col-form-label">Abbreviation</label>
      </div>
      <div class="col-4">
        <input type="text" name="opusId" id="id" value="<%= opus.opusId %>" class="form-control" />
      </div>
    </div>

    <div class="row p-5">
      <div class="col-2">
        <label for="title" class="col-form-label">Work Title</label>
      </div>
      <div class="col-6">
        <input type="text" name="title" id="title" value="<%= opus.title %>" class="form-control">
      </div>
    </div>
    <div class="row p-5">
      <div class="col-2">
        <label class="col-form-label" for="lang">Language</label>
      </div>
      <div class="col-6">
        <select name="language" id="lang" class="form-select">
          <option value="">select a language</option>
          <% for (let l of langs) {
            if (l == opus.language) {%>
              <option value="<%= l %>" selected>
                <%= l %>
              </option>
          <% } else { %>
              <option value="<%= l %>">
                <%= l %>
              </option>
          <% }
          } %>
        </select>
      </div>
    </div>
    <div class="row p-5">
      <div class="col-2">
        <label for="authorId" class="col-form-label">Author Abbreviation</label>
      </div>
      <div class="col-4">
        <input type="text" name="authorId" id="authorId" value="<%= opus.authorId %>" class="form-control">
      </div>
    </div>
    <div class="row p-5">
      <button type="submit" class="col-2 btn btn-success me-3">Save Changes</button>
      <a href="/opera/" class="col-2 btn btn-warning">Cancel</a>
    </div>
  </form>
