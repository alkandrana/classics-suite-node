<% title=locals.title %>

  <form method="post" action="/opera/<%= opus.opusId %>/edit">
    <div class="row p-5">
      <div class="col-2">
        <label for="id" class="col-form-label">Abbreviation</label>
      </div>
      <div class="col-4">
        <input type="text" name="opusCode" id="id" value="<%= opus.opusCode %>" class="form-control" />
      </div>
    </div>

    <div class="row p-5">
      <div class="col-2">
        <label for="title" class="col-form-label">Work Title</label>
      </div>
      <div class="col-6">
        <input type="text" name="title" id="title" value="<%= opus.title %>" class="form-control">
      </div>
    </div>
    <div class="row p-5">
      <div class="col-2">
        <label class="col-form-label" for="lang">Language</label>
      </div>
      <div class="col-6">
        <select name="dialect" id="lang" class="form-select">
          <option value="">select a language</option>
          <% for (let l of langs) {
            if (l === opus.dialect) {%>
              <option value="<%= l %>" selected>
                <%= l %>
              </option>
          <% } else { %>
              <option value="<%= l %>">
                <%= l %>
              </option>
          <% }
          } %>
        </select>
      </div>
    </div>
    <div class="row p-5">
      <div class="col-2">
        <label for="authorId" class="col-form-label">Author</label>
      </div>
      <div class="col-4">
          <select name="authorId" id="authorId" class="form-select">
              <option value="">select an author</option>
              <% for (let a of authors) { %>
                <option value="<%= a.authorId %>" selected="<% a.authorId === opus.authorId %>"><%= a.name %></option>
              <% } %>
          </select>
      </div>
    </div>
    <div class="row p-5">
      <button type="submit" class="col-2 btn btn-success me-3">Save Changes</button>
      <a href="/opera/" class="col-2 btn btn-warning">Cancel</a>
    </div>
  </form>
