<% title=locals.title %>
  <h1>Confirm Delete Work</h1>
  <h2>Are you sure you want to delete <%= opus.title %>?</h2>
  <ul>
    <li>
      Title: <%= opus.title %>
    </li>
    <li>
      Language: <%= opus.language %>
    </li>
    <li>
      Author: <%= opus.author.name %>
    </li>
  </ul>
  <form method="post" action="/opera/<%= opus.authorId %>/<%= opus.opusId %>/delete/">
    <button type="submit">Delete</button>
  </form>
  <a href="/opera/">Cancel</a>
