<% title = 'Works' %>

<h1>List of Works</h1>
<table class="table table-dark table-bordered table-striped">
    <thead>
    <tr>
        <th>Abbreviation</th>
        <th>Title</th>
        <th>Author </th>
    </tr>
    </thead>
    <tbody>
    <% for (let o of opera){ %>
    <tr>
        <td><%= o.opusId %></td>
        <td><%= o.title %></td>
        <td><%= o.author.name %></td>
    </tr>
    <% } %>
    </tbody>
</table>
