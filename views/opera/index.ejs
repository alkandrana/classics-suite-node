<% title='Works' %>
<div class="row">
  <h1 class="col">List of Works</h1>
  <a href="/opera/add" class="col-2 align-self-start btn btn-success">Add New Work</a>
</div>
  <table class="table table-dark table-bordered table-striped">
    <thead>
      <tr>
        <th>Abbreviation</th>
        <th>Title</th>
        <th>Author </th>
        <th>Actions</th>
      </tr>
    </thead>
    <tbody>
      <% for (let o of opera){ %>
        <tr>
          <td>
            <%= o.opusId %>
          </td>
          <td>
            <%= o.title %>
          </td>
          <td>
            <%= o.author.name %>
          </td>
          <td>
            <a href="/opera/<%= o.authorId %>/<%= o.opusId %>" class="btn btn-sm btn-success">View Details</a>
          </td>
        </tr>
        <% } %>
    </tbody>
  </table>
