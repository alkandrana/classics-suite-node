<%= title = locals.title %>
<h1>Details</h1>
<div>
    <h4><%= opus.title %></h4>
    <hr />
    <dl class="row">
        <dt class = "col-sm-2">
            Title
        </dt>
        <dd class = "col-sm-10">
            <%=opus.title%>
        </dd>
        <dt class = "col-sm-2">
            Author
        </dt>
        <dd class = "col-sm-10">
            <%=opus.author.name%>
        </dd>
    </dl>
</div>

<div>
    <a href="/opera/">Back to List</a> |
    <a href="/opera/<%= opus.authorId %>/<%= opus.opusId %>/edit" class="link-warning">Edit</a> |
    <a href="/opera/<%= opus.authorId %>/<%= opus.opusId %>/delete" class="link-danger">Delete</a> |
</div>
<hr/>
<% if (opus.textNodes.length > 0) { %>
    <% if (opus.textNodes[0].type === "Line") { %>
        <table class="table table-dark table-bordered table-striped">
            <thead>
            <tr>
                <th>Line</th>
                <th>Text</th>
                <th>Comment</th>
                <th>Vocab</th>
                <th>Actions</th>
            </tr>
            </thead>
            <tbody>
            <% for (let l of opus.textNodes){ %>
                <tr>
                    <td>
                        <%= l.ordinal %>
                    </td>
                    <td>
                        <%= l.text %>
                    </td>
                    <td>
                        Comments Pending
                    </td>
                    <td>
                        Vocab Pending
                    </td>
                    <td>
                        <a href="/nodes/<%= l.id %>/edit" class="link-warning">Edit</a> |
                        <a href="/nodes/<%= l.id %>/delete" class="link-danger">Delete</a> |
                    </td>
                </tr>
            <% } %>
            <tr>
                <td colspan="6" class="text-center">
                    <button type="button" class="btn btn-primary" id="newLineBtn">New Line</button>
                    <form method="post" action="/nodes/add" class="row d-none" id="lineForm">
                        <input type="hidden" name="authorId" value="<%= opus.authorId %>" />
                        <input type="hidden" name="opusId" value="<%= opus.opusId %>" />
                        <input type="hidden" name="type" id="type" value="LINE" />
                        <input type="number" name="ordinal" id="num" class="col-1 bg-dark text-light border-0">
                        <input type="text" name="text" id="text" class="col bg-dark text-light border-0">
                        <button type="submit" class="btn btn-sm btn-secondary col-2 ms-1">Add</button>
                    </form>
                </td>
            </tr>
            </tbody>
        </table>
    <% } else { %>
        <a href="/nodes/add/<%= opus.authorId %>/<%= opus.opusId %>" class="btn btn-success offset-10">Add New Section</a>
        <div class="row">
            <% for (let s of opus.textNodes)
            { %>
            <div class="card col-2 bg-dark text-light m-1 mx-auto" style="width: 18rem;">
                <div class="card-body">
                    <h5 class="card-title"><%= opus.title + " " + s.label %></h5>
                    <%# if(s.Sections.Sum(s => s.Lines.Count) > 0)
                    {
                    <h6 class="card-subtitle mb-2 text-muted">@b.Sections.First().Lines.First().Text</h6>
                    }
                    <p class="card-text">Lines: @b.Sections.Sum(s => s.Lines.Count)</p>%>
                    <a href="/nodes/<%= s.id %>" class="card-link">View <%= s.type %></a>
                </div>
            </div>
            <% } %>
        </div>
    <% } %>
<% } else { %>
    <a href="/nodes/<%= opus.authorId %>/<%= opus.opusId %>/add" class="btn btn-lg btn-primary offset-5">Add New Section</a>
<% } %>

<script>
    function newLine(){
        let button = document.getElementById("newLineBtn");
        let form = document.getElementById("lineForm");
        button.addEventListener("click", function(){
            form.classList.remove("d-none");
            button.classList.add("d-none");
            document.getElementById("num").focus();
        });
    }

    window.onload = () => {
        // toggleVocab();
        newLine();
        window.scrollTo(0, document.body.scrollHeight);
    }
</script>