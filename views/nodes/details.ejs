<%= title = locals.title %>
<h1>Details</h1>
<div class="card col-4 bg-dark text-light m-1">
    <div class="card-body">
        <h5 class="card-title"><%= `${section.opus.author.name} ${section.opus.title} ${label}`%></h5>
        <ul class="list-group list-group-flush bg-dark">
            <li class="list-group-item bg-secondary text-light">Section: <%= section.label %></li>
            <li class="list-group-item bg-secondary text-light">Type: <%= section.type %></li>
            <li class="list-group-item bg-secondary text-light">Author: <%= section.opus.author.name %></li>
            <li class="list-group-item bg-secondary text-light">Work: <%= section.opus.title %></li>
            <li class="list-group-item bg-secondary text-light">Container: <%= parentType %></li>
        </ul>
        <div class="row">
            <a href="/<%= root %>/<%= parent %>" class="col">Back to <%= parentType %></a>
            <a href="/nodes/<%= section.id %>/edit" class="link-warning col">Edit <%= section.type %></a>
            <a href="/nodes/<%= section.id %>/delete" class="link-danger col">Delete <%= section.type %></a>
        </div>
    </div>
</div>
<% if (nodeType === 'empty') {%>
    <a href="/nodes/<%= section.authorId %>/<%= section.opusId %>/<%= section.id %>/add" class="btn btn-lg btn-primary offset-5">Add New Section/Line</a>
<% } else { %>
    <% if (nodeType === "Line") { %>
        <table class="table table-dark table-bordered table-striped">
            <thead>
            <tr>
                <th>Line</th>
                <th>Text</th>
                <th>Comment</th>
                <th>Vocab</th>
                <th>Actions</th>
            </tr>
            </thead>
            <tbody>
            <% for (let l of section.children){ %>
                <tr>
                    <td>
                        <%= l.ordinal %>
                    </td>
                    <td>
                        <%= l.text %>
                    </td>
                    <td>
                        Comments Pending
                    </td>
                    <td>
                        Vocab Pending
                    </td>
                    <td>
                        <div class="row">
                            <a href="/nodes/<%= l.id %>/edit" class="link-warning col-4 pt-1">Edit</a><span class="col-1 pt-1">|</span>
                            <form action="/nodes/<%= l.id %>/delete" method="post" class="col">
                                <input type="hidden" name="id" value="<%= l.id %>">
                                <button type="submit" class="btn btn-link link-danger">
                                    <i class="fa-solid fa-trash-can"></i>
                                </button>
                            </form>
                        </div>
                    </td>
                </tr>
            <% } %>
            <tr>
                <td colspan="6" class="text-center">
                    <button type="button" class="btn btn-primary" id="newLineBtn">New Line</button>
                    <form method="post" action="/nodes/add" class="row d-none" id="lineForm">
                        <input type="hidden" name="authorId" value="<%= section.authorId %>" />
                        <input type="hidden" name="opusId" value="<%= section.opusId %>" />
                        <input type="hidden" name="parentId" value="<%= section.id %>" />
                        <input type="hidden" name="type" id="type" value="Line" />
                        <input type="number" name="ordinal" id="num" class="col-1 bg-dark text-light border-0">
                        <input type="text" name="text" id="text" class="col bg-dark text-light border-0">
                        <button type="submit" class="btn btn-sm btn-secondary col-2 ms-1">Add</button>
                    </form>
                </td>
            </tr>
            </tbody>
        </table>
    <% } else {
        if (nodeType === 'mixed'){ %>
            <h6 class="text-danger"><%= `${section.opus.authorId} ${section.opus.title} ${section.type} ${section.label}`%> contains subsections of more than one type. Please review the elements for data entry mistakes: </h6>
        <% }
        for(let s of section.children) { %>
            <div class="card col-2 bg-dark text-light m-1 mx-auto" style="width: 18rem;">
                <div class="card-body">
                    <h5 class="card-title"><%= `${s.type} ${s.label} `%></h5>
                    <%#<h6 class="card-subtitle mb-2 text-muted">@b.Sections.First().Lines.First().Text</h6>%>
                    <% if (s.children) { %>
                        <p class="card-text"><%= s.children[0].type %>s: <%= s.children.length%></p>
                    <% } else { %>
                        <p class="card-text">Sub-Sections: 0</p>
                    <% } %>
                    <div class="row">
                        <a href="/nodes/<%= s.id %>" class="card-link col-6">View <%= s.type %></a>
                        <a href="/nodes/<%= s.id %>/edit" class="link-warning col">Edit</a> |
                        <form action="/nodes/<%= s.id %>/delete" method="post" class="col">
                            <input type="hidden" name="id" value="<%= s.id %>">
                            <button type="submit" class="btn btn-link link-danger">
                                <i class="fa-solid fa-trash-can"></i>
                            </button>
                        </form>
                    </div>
                </div>
            </div>
        <% } %>
    <% } %>
<% } %>
<script>
    function newLine(){
        let button = document.getElementById("newLineBtn");
        let form = document.getElementById("lineForm");
        button.addEventListener("click", function(){
            form.classList.remove("d-none");
            button.classList.add("d-none");
            document.getElementById("num").focus();
        });
    }

    window.onload = () => {
        // toggleVocab();
        newLine();
        window.scrollTo(0, document.body.scrollHeight);
    }
</script>
