<%= title = locals.title %>
<h1><%= `${section.opus.author.name} ${section.opus.title} ${section.type} ${section.label}`%></h1>

<% if (section.children.length === 0) {%>
    <a href="/nodes/<%= section.authorId %>/<%= section.opusId %>/<%= section.id %>/add" class="btn btn-lg btn-primary offset-5">Add New Section/Line</a>
<% } else { %>
    <% if (section.children[0].type === "LINE") { %>
        <a href="/nodes/<%= section.opus.authorId %>/<%= section.opus.opusId %>/<%= section.id %>" class="link-success">Add Line</a> |
        <table class="table table-dark table-bordered table-striped">
            <thead>
            <tr>
                <th>Line</th>
                <th>Text</th>
                <th>Comment</th>
                <th>Vocab</th>
                <th>Actions</th>
            </tr>
            </thead>
            <tbody>
            <% for (let l of section.children){ %>
                <tr>
                    <td>
                        <%= l.ordinal %>
                    </td>
                    <td>
                        <%= l.text %>
                    </td>
                    <td>
                        Comments Pending
                    </td>
                    <td>
                        Vocab Pending
                    </td>
                    <td>
                        <a href="/nodes/<%= l.id %>/edit" class="link-warning">Edit</a> |
                        <a href="/nodes/<%= l.id %>/delete" class="link-danger">Delete</a> |
                    </td>
                </tr>
            <% } %>
            </tbody>
        </table>
    <% } else {
        for(let s of section.children) { %>
            <div class="card col-2 bg-dark text-light m-1 mx-auto" style="width: 18rem;">
                <div class="card-body">
                    <h5 class="card-title"><%= `${s.type} ${s.label} `%></h5>
                    <%#<h6 class="card-subtitle mb-2 text-muted">@b.Sections.First().Lines.First().Text</h6>%>
                    <% if (s.children.length > 0) { %>
                        <p class="card-text"><%= s.children[0].type %>s: <%= s.children.length%></p>
                    <% } %>
                    <p class="card-text">Sub-Sections: <%= s.children.length %></p>
                    <a href="/nodes/<%= s.id %>" class="card-link">View <%= s.type %></a>
                </div>
            </div>
        <% } %>
    <% } %>
<% } %>